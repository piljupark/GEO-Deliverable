# 이 파일은 예시입니다. 실제 값은 절대 여기(파일)에 쓰지 말고
# Render 대시보드의 Environment 탭에서만 설정하세요.

APP_USERNAME=admin
APP_PASSWORD=여기에_강력한_비밀번호
SESSION_SECRET=아무-긴-랜덤-문자열
REFRESH_TOKEN=cron-job.org에서-쓸-임의의-긴-문자열

GSC_SITE_URL=sc-domain:studio.kma.or.kr
GSC_MOCK=true
# 서비스계정 JSON 파일의 "내용 전체"를 한 줄로 붙여넣기 (아래 SETUP.md 참고)
GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

GA4_PROPERTY_ID=123456789
GA4_MOCK=true
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=
NAVER_MOCK=true

SERPAPI_KEY=

MY_URL=https://studio.kma.or.kr
COMPETITOR_URLS=https://competitor1.com,https://competitor2.com
TARGET_KEYWORDS=강사 섭외,강사 매칭
