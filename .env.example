# 이 파일은 예시입니다. 실제 값은 절대 여기(파일)에 쓰지 말고
# Render 대시보드의 Environment 탭에서만 설정하세요.

APP_USERNAME=admin
APP_PASSWORD=여기에_강력한_비밀번호
SESSION_SECRET=아무-긴-랜덤-문자열

# 선택: 없어도 /analyze는 동작하지만 쿼터가 매우 낮아 429 에러가 잦음
PAGESPEED_API_KEY=

# Gemini AI 노출 추적 (무료 티어, 카드 불필요) — aistudio.google.com/apikey 에서 발급
# /analyze에 입력된 URL을 크롤링해서 질문을 자동 생성하므로 이 키만 있으면 됨
GEMINI_API_KEY=
